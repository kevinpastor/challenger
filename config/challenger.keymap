#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/ext_power.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                            &kp ESC     &kp N1      &kp N2      &kp N3      &kp N4      &kp N5      &kp N6
                            &kp TAB     &kp Q       &kp W       &kp E       &kp R       &kp T       &kp N7
                            &kp CAPS    &kp A       &kp S       &kp D       &kp F       &kp G       &kp N8
                &none       &kp LSHFT   &kp Z       &kp X       &kp C       &kp V       &kp B       &kp N9
                &none       &kp LCTRL   &kp LALT              &mo 2       &mo 1       &kp SPACE
            >;
        };

        second {
            bindings = <
                            &trans      &trans      &trans      &trans      &trans      &trans      &trans
                            &trans      &kp P       &kp O       &kp I       &kp U       &kp Y       &trans
                            &trans      &trans      &kp L       &kp K       &kp J       &kp H       &trans
                &trans      &trans      &trans      &trans      &trans      &kp M       &kp N       &kp N0
                &trans      &trans      &trans                  &trans      &trans      &kp SPACE
            >;
        };

        third {
            bindings = <
                            &studio_unlock &kp F1   &kp F2      &kp F3      &kp F4      &kp F5      &kp F6
                            &ext_power EP_TOG &trans &trans     &trans      &trans      &trans      &kp F7
                            &trans      &trans      &trans      &trans      &trans      &trans      &kp F8
                &kp F9      &trans      &trans      &trans      &trans      &trans      &trans      &kp F9
                &kp LGUI    &trans      &trans                  &trans      &trans      &kp SPACE
            >;
        };
    };
};
